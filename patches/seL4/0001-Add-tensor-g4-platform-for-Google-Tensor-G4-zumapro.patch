index bc040b7e9..6c7336f9c 100644
--- a/src/drivers/serial/config.cmake
+++ b/src/drivers/serial/config.cmake
@@ -16,6 +16,8 @@ register_driver(compatibility_strings "fsl,imx8qxp-lpuart;fsl,imx7ulp-lpuart"
                 PREFIX src/drivers/serial CFILES "imx-lpuart.c")
 register_driver(compatibility_strings "samsung,exynos4210-uart" PREFIX src/drivers/serial
                 CFILES "exynos4210-uart.c")
