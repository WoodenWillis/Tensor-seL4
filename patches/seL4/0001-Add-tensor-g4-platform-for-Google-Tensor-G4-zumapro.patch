 src/plat/tensor-g4/config.cmake               |  34 ++++++
 src/plat/tensor-g4/overlay-tensor-g4.dts      |  63 +++++++++++
 tools/dts/tensor-g4.dts                       | 105 ++++++++++++++++++
 tools/hardware.yml                            |   1 +
 7 files changed, 312 insertions(+)
