+            &{/s2mpu_s0_dpuf1@19c70000},
+            &{/s2mpu_s0_eh@16c70000},
+            &{/s2mpu_s0_g2d@1a8a0000},
+            &{/s2mpu_s0_g3d@1ee70000},
+            &{/s2mpu_s0_gdc@1d4f0000},
+            &{/s2mpu_s0_gse@1d8a0000},
+            &{/s2mpu_s0_hsi0@11070000},
+            &{/s2mpu_s0_hsi1@12090000},
+            &{/s2mpu_s0_hsi2@131f0000},
+            &{/s2mpu_s0_ispfe@1c140000},
+            &{/s2mpu_s1_ispfe@1c180000},
+            &{/s2mpu_s2_ispfe@1c1c0000},
+            &{/s2mpu_s0_mcsc@1d0d0000},
+            &{/s2mpu_s0_mfc@1a4a0000},
+            &{/s2mpu_s0_misc@101f0000},
+            &{/s2mpu_s0_rgbp@1c4d0000},
+            &{/s2mpu_s1_rgbp@1c510000},
+            &{/s2mpu_s0_tnr@1ccb0000},
+            &{/s2mpu_s1_tnr@1ccf0000},
+            &{/s2mpu_s2_tnr@1cd30000},
+            &{/s2mpu_s0_tpu@1a370000},
+            &{/s2mpu_s0_yuvp@1c8a0000},
+            &{/s2mpu_s0_gsa@16470000},
+            &{/s2mpu_s0_aoc@190c0000},
+            &{/s2mpu_s0_alive@155b0000};
     };
 
     memory@80000000 {
