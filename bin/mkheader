#!/usr/bin/env python3

import struct
raw = open('images/sel4test-driver-image-arm-tensor-g4','rb').read()   # UNPATCHED, straight from ninja

HDR = 0x1000                      # one page of header, keeps everything 4K aligned
LOAD = 0x80688000 - HDR           # = 0x80687000 -> _start lands on 0x80688000

hdr = bytearray(HDR)
struct.pack_into('<I', hdr, 0x00, 0x14000000 | (HDR // 4))  # b .+0x1000  (jump over header)
struct.pack_into('<Q', hdr, 0x08, LOAD - 0x80000000)        # text_offset = 0x687000
struct.pack_into('<Q', hdr, 0x10, HDR + len(raw))           # image_size
struct.pack_into('<Q', hdr, 0x18, 0xA)                      # flags: LE, 4K, anywhere
struct.pack_into('<I', hdr, 0x38, 0x644d5241)               # "ARM\x64"
struct.pack_into('<I', hdr, 0x3c, 0)

open('sel4-Image.hdr','wb').write(bytes(hdr) + raw)
print("load at", hex(LOAD), "_start at", hex(LOAD + HDR), "size", HDR + len(raw))
